rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isGodfather() {
      return request.auth != null
        && ((request.auth.token.email == 'joel.s.gomes001@gmail.com')
            || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'godfather'));
    }
    function isAdmin() {
      return request.auth != null
        && (isGodfather()
            || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin','superadmin','godfather']));
    }
    function isSuperAdmin() {
      return request.auth != null
        && (isGodfather()
            || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['superadmin','godfather']));
    }

    match /streamState/{doc}  {
      allow read: if true;
      allow write: if (doc == 'srinjana') ? isGodfather() : isAdmin();
    }
    match /epg/{id}           {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/godfatherCredentials {
      allow read, write: if isGodfather();
    }
    match /config/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /announcement/current{ allow read: if true; allow write: if isAdmin(); }
    match /blessCount/main    { allow read: if true; allow write: if true; }
    match /decoderStatus/{id} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /decoderControl/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /decoderBroadcast/{doc} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /activeViewers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() || id == request.resource.data.id || (request.resource == null && resource.data.id == id);
    }
    match /viewers/{id}       {
      allow read, write: if isAdmin();
    }
    match /chat/{id}          {
      allow read: if true;
      allow create: if request.resource.data.name.size() <= 100
                    && request.resource.data.message.size() <= 300
                    && request.resource.data.timestamp == request.time;
      allow delete: if isAdmin();
    }
    match /blessings/{id}     {
      allow read: if true;
      allow create: if request.resource.data.name.size() <= 100
                    && request.resource.data.message.size() <= 300
                    && request.resource.data.timestamp == request.time;
      allow delete: if isAdmin();
    }
    match /quotes/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /admins/{uid}       {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isSuperAdmin();
      allow update: if isGodfather() || (isSuperAdmin() && resource.data.role != 'godfather' && request.resource.data.role != 'godfather');
      allow delete: if isGodfather() || (isSuperAdmin() && resource.data.role != 'godfather');
    }
  }
}
