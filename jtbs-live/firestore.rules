rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin','superadmin'];
    }
    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /streamState/{doc}  {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /epg/{id}           {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /announcement/current{ allow read: if true; allow write: if isAdmin(); }
    match /blessCount/main    { allow read: if true; allow write: if true; }
    match /decoderStatus/{id} {
      allow read: if isAdmin();
      allow write: if true;
    }
    match /decoderControl/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /activeViewers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() || id == request.resource.data.id || (request.resource == null && resource.data.id == id);
    }
    match /viewers/{id}       {
      allow read, write: if isAdmin();
    }
    match /chat/{id}          {
      allow read: if true;
      allow create: if request.resource.data.name.size() <= 100
                    && request.resource.data.message.size() <= 300
                    && request.resource.data.timestamp == request.time;
      allow delete: if isAdmin();
    }
    match /blessings/{id}     {
      allow read: if true;
      allow create: if request.resource.data.name.size() <= 100
                    && request.resource.data.message.size() <= 300
                    && request.resource.data.timestamp == request.time;
      allow delete: if isAdmin();
    }
    match /quotes/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /admins/{uid}       {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();
    }
  }
}
